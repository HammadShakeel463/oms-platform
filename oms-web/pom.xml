<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oms</groupId>
        <artifactId>oms-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>oms-web</artifactId>
    <name>oms-web</name>
    <description>Shared Spring web plumbing: the global exception handler that renders the
        ApiError contract, and the trace-id filter. Delivered as a Boot auto-configuration so a
        service gets both by adding the dependency. Separate from oms-common because oms-common
        must stay free of Spring (ADR 0001).</description>

    <dependencies>
        <dependency>
            <groupId>com.oms</groupId>
            <artifactId>oms-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- provided: the consuming service brings its own web starter, and this module
                 must never drag Tomcat into a service that chose WebFlux (the gateway). -->
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Optional: the security helpers are only wired when a service is actually a
                 resource server.  keeps oms-web usable without it. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Optional: only the OpenAPI helper needs it, and that is @ConditionalOnClass. -->
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
