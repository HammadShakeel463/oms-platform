<?xml version="1.0" encoding="UTF-8"?>
<!--
  ONE logging configuration for all five services.

  It lives in oms-web, which every service depends on, and Spring Boot picks up
  logback-spring.xml from anywhere on the classpath. Five identical copies would be five
  places for a field name to drift, and a log aggregator cannot query across services whose
  fields are named differently.

  Format is chosen by Spring profile, using <springProfile> rather than Logback's <if>.
  That matters: <if> requires the Janino library at runtime, and without it Logback skips the
  conditional block entirely - leaving the root logger with no appender and the service
  silently producing no logs at all. <springProfile> is handled by Boot itself and needs
  nothing extra.

    default                     human-readable console output, for local development
    docker, k8s or json profile one JSON object per line, for a log aggregator

  JSON is not prettier, it is queryable. "Every WARN for traceId X across all five services"
  is a field lookup against structured logs and a regex guess against text ones.
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="oms"/>
    <springProperty scope="context" name="env" source="oms.environment" defaultValue="local"/>

    <!-- Human-readable. traceId is in the pattern because a log line that cannot be
         correlated with a request is the first thing anybody complains about. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId:-}] %logger{32} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      Structured output.

      The MDC is included wholesale, which is what carries traceId, spanId, orderId and
      tradeId - placed there by the trace filter and the Kafka listeners - without any log
      statement having to pass them explicitly.

      Stack traces are shortened on purpose. A full Spring stack trace is well over a hundred
      frames of framework internals, and the ones that matter are at the top and the bottom.
      Keeping everything makes logs expensive to store and harder to read, which is how people
      end up not reading them.
    -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                </timestamp>
                <logLevel/>
                <loggerName>
                    <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                </loggerName>
                <threadName/>
                <message/>
                <pattern>
                    <pattern>{"service":"${appName}","env":"${env}"}</pattern>
                </pattern>
                <mdc/>
                <arguments/>
                <stackTrace>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>4096</maxLength>
                        <shortenedClassNameLength>40</shortenedClassNameLength>
                        <exclude>^org\.springframework\.aop\..*</exclude>
                        <exclude>^org\.springframework\.web\.filter\..*</exclude>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <springProfile name="docker | k8s | json">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="!docker &amp; !k8s &amp; !json">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <logger name="com.oms" level="DEBUG"/>

    <!-- Framework noise that is INFO by default and says nothing useful in steady state. -->
    <logger name="org.apache.kafka.clients.consumer.internals" level="WARN"/>
    <logger name="org.apache.kafka.clients.NetworkClient" level="ERROR"/>
    <logger name="org.apache.kafka.common.utils.AppInfoParser" level="WARN"/>
    <logger name="org.hibernate.orm.deprecation" level="ERROR"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>

</configuration>
